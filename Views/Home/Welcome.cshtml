@using System.Security.Claims
@{
    ViewData["Title"] = "Welcome";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
}

<div class="dt-card p-4 p-lg-5 mb-4">
    <p class="dt-eyebrow"><span></span>Signed in as <strong class="ms-1">@role</strong></p>
    <h1 class="dt-display">Welcome, <span class="text-red">@fullName</span></h1>
    <p class="text-secondary-dt mb-0">
        Your role-specific dashboard will appear here once the other pages are connected.
        Use the menu above to open the pages that are ready.
    </p>
</div>

@if (role == "FrontDesk" || role == "Owner")
{
    <div class="row g-3">
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="Quotations" asp-action="Index">
                <i class="bi bi-file-earmark-text"></i>
                <div><strong>Quotations</strong><span>Build estimates & owner approvals</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="JobCards" asp-action="Board">
                <i class="bi bi-clipboard-check"></i>
                <div><strong>Job card board</strong><span>See every job by status</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="JobCards" asp-action="Create">
                <i class="bi bi-plus-circle"></i>
                <div><strong>New job card</strong><span>Open a job for a vehicle</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="Invoices" asp-action="Index">
                <i class="bi bi-receipt"></i>
                <div><strong>Invoices & Payments</strong><span>Customer billing, print invoices & payments</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="Suppliers" asp-action="Index">
                <i class="bi bi-truck"></i>
                <div><strong>Parts Suppliers</strong><span>Vendor directory & parts supplied list</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="Appointments" asp-action="Index">
                <i class="bi bi-calendar-check"></i>
                <div><strong>Appointments</strong><span>Confirm, reschedule & view requests</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="FrontDesk" asp-controller="Appointments" asp-action="Calendar">
                <i class="bi bi-calendar3"></i>
                <div><strong>Calendar View</strong><span>Day & week view of booked slots</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="" asp-controller="ServiceHistory" asp-action="Index" asp-route-vehicleNo="CAB-1234">
                <i class="bi bi-clock-history"></i>
                <div><strong>Service history</strong><span>Review completed work by vehicle</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="" asp-controller="Employees" asp-action="Index">
                <i class="bi bi-person-badge"></i>
                <div><strong>Employees</strong><span>Staff directory, roles &amp; hourly rates</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="" asp-controller="Attendance" asp-action="Clock">
                <i class="bi bi-stopwatch"></i>
                <div><strong>Clock In / Out</strong><span>Record daily staff clock-in and clock-out</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-4">
            <a class="dt-quick" asp-area="" asp-controller="Attendance" asp-action="Sheet">
                <i class="bi bi-calendar3-week"></i>
                <div><strong>Attendance Sheet</strong><span>Monthly hours, late arrivals &amp; overtime</span></div>
            </a>
        </div>
        @if (role == "Owner")
        {
            <div class="col-md-6 col-xl-4">
                <a class="dt-quick" asp-area="" asp-controller="UserAdmin" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <div><strong>User administration</strong><span>Manage accounts, roles and access</span></div>
                </a>
            </div>
        }
    </div>
}

@if (role == "Mechanic")
{
    <div class="row g-3">
        <div class="col-md-6">
            <a class="dt-quick" asp-area="" asp-controller="Attendance" asp-action="Clock">
                <i class="bi bi-stopwatch"></i>
                <div><strong>Clock In / Out</strong><span>Live shift clock and today's attendance entry</span></div>
            </a>
        </div>
        <div class="col-md-6">
            <a class="dt-quick" asp-area="" asp-controller="Attendance" asp-action="Sheet">
                <i class="bi bi-calendar3-week"></i>
                <div><strong>My Attendance Sheet</strong><span>Monthly hours worked, late arrivals &amp; overtime</span></div>
            </a>
        </div>
    </div>
}

@if (role == "Customer")
{
    <div class="row g-3">
        <div class="col-md-6 col-xl-6">
            <a class="dt-quick" asp-area="" asp-controller="Appointments" asp-action="Book">
                <i class="bi bi-calendar-plus"></i>
                <div><strong>Book an Appointment</strong><span>Pick a vehicle, service type, date & time slot</span></div>
            </a>
        </div>
        <div class="col-md-6 col-xl-6">
            <a class="dt-quick" asp-area="" asp-controller="CustomerPortal" asp-action="Index">
                <i class="bi bi-person-circle"></i>
                <div><strong>Customer Portal</strong><span>Manage your profile, vehicles and appointments</span></div>
            </a>
        </div>
    </div>
}

