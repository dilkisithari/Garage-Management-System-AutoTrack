@using AutoTrack.Models.Payroll
@model PayslipViewModel
@{
    ViewData["Title"] = $"Payslip - {Model.Row.EmployeeName}";
}

@section Styles {
    <style>
        @@media print {
            header.dt-nav-wrap,
            footer.dt-footer,
            .dt-alert,
            .ps-noprint {
                display: none !important;
            }
            body, .dt-body, .dt-main {
                background: #ffffff !important;
                color: #111111 !important;
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }
            .ps-sheet {
                background: #ffffff !important;
                color: #111111 !important;
                border: 1px solid #cccccc !important;
                box-shadow: none !important;
            }
            .ps-sheet .text-white,
            .ps-sheet .text-secondary-dt,
            .ps-sheet .text-success {
                color: #111111 !important;
            }
            .ps-sheet .table-dark {
                --bs-table-bg: #ffffff;
                --bs-table-color: #111111;
                --bs-table-border-color: #dddddd;
                color: #111111 !important;
            }
            .ps-box {
                background: #f8f9fa !important;
                border-color: #dddddd !important;
            }
        }
    </style>
}

<div class="dt-page-head mb-4 ps-noprint">
    <div>
        <a asp-action="Index" asp-route-month="@Model.MonthKey" class="dt-back">
            <i class="bi bi-arrow-left me-1"></i>Back to Payroll Run
        </a>
        <h1 class="dt-h1 mb-1"><i class="bi bi-file-earmark-text me-2 text-red"></i>Employee Payslip</h1>
        <p class="text-secondary-dt mb-0">Printable salary statement for @Model.Row.EmployeeName &middot; @Model.MonthLabel</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print Payslip
        </button>
    </div>
</div>

<div class="dt-card p-4 p-md-5 ps-sheet mx-auto" style="max-width: 860px;">
    <!-- Company Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start border-bottom border-secondary pb-4 mb-4 gap-3">
        <div>
            <h2 class="h4 fw-bold text-white mb-1">D Tech Motors &amp; Modification (Pvt) Ltd</h2>
            <div class="small text-secondary-dt">No. 142, Pannipitiya Road, Battaramulla, Sri Lanka</div>
            <div class="small text-secondary-dt">AutoTrack Payroll &amp; HR Department</div>
        </div>
        <div class="text-md-end">
            <div class="text-uppercase small text-secondary-dt">Payslip</div>
            <div class="fw-bold text-white fs-5">@Model.MonthLabel</div>
            <div class="small text-secondary-dt">Ref: <code>@Model.PayslipNumber</code></div>
            <div class="mt-1">
                @if (Model.Row.IsPaid)
                {
                    <span class="badge bg-success">Paid</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending Run</span>
                }
            </div>
        </div>
    </div>

    <!-- Employee & Period Details -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 rounded border border-secondary ps-box h-100">
                <div class="small text-uppercase text-secondary-dt mb-2">Employee Details</div>
                <div class="fw-bold text-white fs-5">@Model.Row.EmployeeName</div>
                <div class="small text-secondary-dt">Employee ID: <strong class="text-white">@Model.EmployeeCode</strong></div>
                <div class="small text-secondary-dt">Designation: <strong class="text-white">@Model.Row.Role</strong></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 rounded border border-secondary ps-box h-100">
                <div class="small text-uppercase text-secondary-dt mb-2">Pay Summary</div>
                <div class="small text-secondary-dt">Pay Period: <strong class="text-white">@Model.PayPeriod</strong></div>
                <div class="small text-secondary-dt">Hourly Rate: <strong class="text-white">LKR @Model.Row.HourlyRate.ToString("N2")/hr</strong></div>
                <div class="small text-secondary-dt">Overtime Rate (1.5&times;): <strong class="text-white">LKR @Model.Row.OvertimeRate.ToString("N2")/hr</strong></div>
            </div>
        </div>
    </div>

    <!-- Earnings & Deductions -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h3 class="h6 text-uppercase text-secondary-dt mb-2">Earnings</h3>
            <div class="table-responsive">
                <table class="table table-dark table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Hours</th>
                            <th class="text-end">Amount (LKR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Basic Pay</td>
                            <td class="text-end">@Model.Row.RegularHours.ToString("N1")</td>
                            <td class="text-end">@Model.Row.BasicPay.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Overtime Pay (1.5&times;)</td>
                            <td class="text-end">@Model.Row.OvertimeHours.ToString("N1")</td>
                            <td class="text-end">@Model.Row.OvertimePay.ToString("N2")</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td>Gross Earnings</td>
                            <td class="text-end">@((Model.Row.RegularHours + Model.Row.OvertimeHours).ToString("N1"))</td>
                            <td class="text-end">LKR @Model.Row.GrossSalary.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="col-md-6">
            <h3 class="h6 text-uppercase text-secondary-dt mb-2">Deductions</h3>
            <div class="table-responsive">
                <table class="table table-dark table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount (LKR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Employee EPF Contribution</td>
                            <td class="text-end">8.0%</td>
                            <td class="text-end">@Model.Row.EpfDeduction.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>Salary Advances / Other</td>
                            <td class="text-end">&mdash;</td>
                            <td class="text-end">0.00</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Total Deductions</td>
                            <td class="text-end">LKR @Model.Row.EpfDeduction.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Net Salary Box -->
    <div class="p-3 p-md-4 rounded border border-secondary ps-box d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
        <div>
            <div class="text-uppercase small text-secondary-dt">Net Salary Payable</div>
            <div class="small text-secondary-dt">
                @(Model.PaidAt.HasValue ? $"Paid on {Model.PaidAt.Value:dd MMM yyyy}" : "Awaiting monthly payroll run")
            </div>
        </div>
        <div class="fs-3 fw-bold text-success">LKR @Model.Row.NetSalary.ToString("N2")</div>
    </div>

    <!-- Signatures -->
    <div class="row pt-4 mt-4 border-top border-secondary text-center small text-secondary-dt g-4">
        <div class="col-6">
            <div class="border-bottom border-secondary pb-4 mb-2 mx-auto" style="max-width: 200px;"></div>
            Authorized Signature (Owner / Accountant)
        </div>
        <div class="col-6">
            <div class="border-bottom border-secondary pb-4 mb-2 mx-auto" style="max-width: 200px;"></div>
            Employee Signature (@Model.Row.EmployeeName)
        </div>
    </div>
</div>
