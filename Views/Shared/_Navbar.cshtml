@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<header class="dt-nav-wrap">
    <nav class="navbar navbar-expand-lg dt-navbar">
        <div class="container-xxl">
            <a class="dt-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-gear-wide-connected dt-brand-icon"></i>
                <span class="dt-brand-text">
                    <span class="dt-brand-name">D Tech <span class="text-red">Motors</span></span>
                    <small>Service &bull; Modify &bull; Drive Better</small>
                </span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list text-white fs-2"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link dt-nav-link @(controller == "Home" && action == "Index" && area == null ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link dt-nav-link @(controller == "Appointments" && action == "Book" && area == null ? "active" : "")" asp-area="" asp-controller="Appointments" asp-action="Book">Book Appointment</a>
                    </li>

                    @if (isAuth)
                    {
                        <li class="nav-item">
                            <a class="nav-link dt-nav-link @(action == "Welcome" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Welcome">Dashboard</a>
                        </li>

                        @if (role == "FrontDesk" || role == "Owner")
                        {

                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(area == "FrontDesk" && controller == "Quotations" ? "active" : "")" asp-area="FrontDesk" asp-controller="Quotations" asp-action="Index">Quotations</a>
                             </li>

                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(area == "FrontDesk" && controller == "JobCards" ? "active" : "")" asp-area="FrontDesk" asp-controller="JobCards" asp-action="Board">Job cards</a>
                             </li>

                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(area == "FrontDesk" && controller == "Invoices" ? "active" : "")" asp-area="FrontDesk" asp-controller="Invoices" asp-action="Index">Invoices</a>
                             </li>

                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(area == "FrontDesk" && controller == "Suppliers" ? "active" : "")" asp-area="FrontDesk" asp-controller="Suppliers" asp-action="Index">Suppliers</a>
                             </li>

                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(area == "FrontDesk" && controller == "Appointments" ? "active" : "")" asp-area="FrontDesk" asp-controller="Appointments" asp-action="Index">Appointments</a>
                             </li>

                              <li class="nav-item">
                                  <a class="nav-link dt-nav-link @(controller == "ServiceHistory" ? "active" : "")" asp-area="" asp-controller="ServiceHistory" asp-action="Index">Service history</a>
                              </li>
                        }

                        @if (role == "Customer")
                        {
                             <li class="nav-item">
                                 <a class="nav-link dt-nav-link @(controller == "CustomerPortal" || (controller == "Appointments" && action == "My") ? "active" : "")" asp-area="" asp-controller="CustomerPortal" asp-action="Index">Customer Portal</a>
                             </li>
                        }

                        @if (role == "Owner")
                        {
                            <li class="nav-item">
                                <a class="nav-link dt-nav-link @(controller == "UserAdmin" ? "active" : "")" asp-area="" asp-controller="UserAdmin" asp-action="Index">User admin</a>
                            </li>
                        }


                        <li class="nav-item dropdown ms-lg-2">
                            <button class="btn dt-user-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>@fullName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dt-dropdown">
                                <li><h6 class="dropdown-header">@role</h6></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-outline-dt" asp-area="" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
