<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - D Tech Motors AutoTrack</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@@0,400;0,600;0,700;0,800;1,700;1,800&family=Inter:wght@@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="dt-body">
    <partial name="_Navbar" />

    <main class="dt-main container-xxl py-4">
        @if (TempData["Success"] is string okMessage)
        {
            <div class="alert alert-success alert-dismissible fade show dt-alert" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@okMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string errMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show dt-alert" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="dt-footer">
        <div class="container-xxl d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>&copy; @DateTime.Now.Year D Tech Motors and Modification (Pvt) Ltd, Battaramulla</span>
            <span class="text-secondary">AutoTrack Garage Management System</span>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
