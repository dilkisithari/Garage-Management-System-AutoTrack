@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="dt-card p-4">
            <h1 class="dt-h1 mb-1">Change password</h1>
            <p class="text-secondary-dt mb-4">Use at least 6 characters.</p>

            <form asp-action="ChangePassword" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger dt-alert py-2"></div>

                <div class="mb-3">
                    <label asp-for="OldPassword" class="form-label"></label>
                    <input asp-for="OldPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="OldPassword" class="field-validation-msg"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="field-validation-msg"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-msg"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Update password</button>
                    <a asp-controller="Home" asp-action="Welcome" class="btn btn-outline-dt">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
