@model ProfitFilterViewModel
@{
    var options = ViewData["MonthOptions"] as List<(string Value, string Text)> ?? new();
}
<form method="get" asp-controller="Reports" asp-action="Profit" class="dt-card dt-toolbar rp-filter rp-noprint mb-4">
    <div class="row g-2 align-items-start">
        <div class="col-12 col-md-5 col-lg-4">
            <label asp-for="Month" class="form-label"></label>
            <select asp-for="Month" class="form-select">
                <option value="">Select month</option>
                @foreach (var o in options)
                {
                    <option value="@o.Value" selected="@(o.Value == Model.Month)">@o.Text</option>
                }
            </select>
            <span asp-validation-for="Month" class="field-validation-msg"></span>
        </div>
        <div class="col-12 col-md-auto align-self-end">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-calculator me-1"></i>Show profit</button>
        </div>
    </div>
</form>
