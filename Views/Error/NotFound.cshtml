@{
    ViewData["Title"] = "Page not found";
}
<div class="dt-error text-center">
    <div class="dt-error-code">404</div>
    <h1 class="dt-h1">Page not found</h1>
    <p class="text-secondary-dt mb-4">The page you are looking for does not exist or was moved.</p>
    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house me-1"></i>Go to home</a>
        <a href="javascript:history.back()" class="btn btn-outline-dt">Go back</a>
    </div>
</div>
