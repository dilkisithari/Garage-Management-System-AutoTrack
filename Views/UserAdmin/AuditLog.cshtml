@model AuditLogViewModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="dt-page-head d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="dt-eyebrow mb-1"><span></span>Owner tools</p>
        <h1 class="dt-h1 mb-1"><i class="bi bi-journal-text text-red me-2"></i>Audit Log</h1>
        <p class="text-secondary-dt mb-0">Review account and profile activity by user, date or action.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-dt"><i class="bi bi-arrow-left me-1"></i>User administration</a>
</div>

<div class="dt-card p-4 mb-4">
    <form asp-action="AuditLog" method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label for="username" class="form-label">User</label>
            <select id="username" name="username" class="form-select">
                <option value="">All users</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user" selected="@(Model.SelectedUser == user)">@user</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="date" class="form-label">Date</label>
            <input id="date" name="date" type="date" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="action" class="form-label">Action</label>
            <select id="action" name="action" class="form-select">
                <option value="">All actions</option>
                @foreach (var action in Model.Actions)
                {
                    <option value="@action" selected="@(Model.SelectedAction == action)">@action</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a asp-action="AuditLog" class="btn btn-outline-dt">Clear</a>
        </div>
    </form>
</div>

<div class="dt-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table dt-table align-middle mb-0">
            <thead><tr><th class="ps-4">When</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
            <tbody>
                @if (Model.Entries.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-secondary py-5">No audit records match these filters.</td></tr>
                }
                else
                {
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td class="ps-4 text-nowrap">@entry.At.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="text-white">@entry.Username</td>
                            <td><span class="badge bg-secondary">@entry.Action</span></td>
                            <td>@entry.Details</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
