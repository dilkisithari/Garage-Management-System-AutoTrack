@model List<AppointmentViewModel>
@{
    ViewData["Title"] = "Service Appointments";
    var search = (string)ViewBag.Search;
    var status = (string)ViewBag.Status;
    var date = (string)ViewBag.Date;
    var allTimeSlots = (string[])ViewBag.AllTimeSlots;
}

<div class="dt-page-head d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="dt-h1 mb-1"><i class="bi bi-calendar2-range me-2 text-red"></i>Service Appointments</h1>
        <p class="text-secondary-dt mb-0">Manage customer bookings, schedule confirmations, reschedules and cancellations</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Calendar" class="btn btn-outline-dt">
            <i class="bi bi-calendar3 me-1 text-red"></i>Calendar View
        </a>
        <a asp-area="" asp-controller="Appointments" asp-action="Book" class="btn btn-primary" target="_blank">
            <i class="bi bi-plus-lg me-1"></i>New Booking
        </a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-info fs-3">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Total Bookings</small>
                <div class="fs-4 fw-bold text-white">@ViewBag.TotalCount</div>
                <small class="text-secondary-dt">All time reservations</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-warning fs-3">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Pending Review</small>
                <div class="fs-4 fw-bold text-warning">@ViewBag.PendingCount</div>
                <small class="text-secondary-dt">Awaiting confirmation</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-success fs-3">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Confirmed</small>
                <div class="fs-4 fw-bold text-success">@ViewBag.ConfirmedCount</div>
                <small class="text-secondary-dt">Scheduled in garage</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-danger fs-3">
                <i class="bi bi-x-circle"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Cancelled</small>
                <div class="fs-4 fw-bold text-danger">@ViewBag.CancelledCount</div>
                <small class="text-secondary-dt">Postponed or voided</small>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="dt-card dt-toolbar mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input name="search" type="search" value="@search" class="form-control" placeholder="Search by customer, vehicle, ref #, phone..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Pending" selected="@(status == "Pending")">Pending only</option>
                <option value="Confirmed" selected="@(status == "Confirmed")">Confirmed only</option>
                <option value="Cancelled" selected="@(status == "Cancelled")">Cancelled only</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="date" value="@date" class="form-control" title="Filter by appointment date" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-outline-dt" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<!-- Appointments Table -->
@if (Model.Count == 0)
{
    <div class="dt-card p-5 text-center">
        <i class="bi bi-calendar-x fs-1 text-secondary mb-3 d-block"></i>
        <h4 class="text-white">No Appointments Found</h4>
        <p class="text-secondary-dt mb-3">No appointments match your filter criteria.</p>
        <a asp-action="Index" class="btn btn-outline-dt btn-sm">Clear Filters</a>
    </div>
}
else
{
    <div class="dt-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Ref #</th>
                        <th>Date & Time Slot</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Service Type</th>
                        <th>Notes</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong class="text-white font-monospace">@appt.AppointmentNo</strong>
                                <div class="small text-secondary">@appt.CreatedAt.ToString("yyyy-MM-dd")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-white">@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                <div class="small text-secondary-dt"><i class="bi bi-clock me-1 text-red"></i>@appt.TimeSlot</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-white">@appt.CustomerName</div>
                                <div class="small text-secondary"><i class="bi bi-telephone me-1"></i>@appt.CustomerPhone</div>
                            </td>
                            <td>
                                <div><span class="badge bg-danger">@appt.VehicleNo</span></div>
                                <small class="text-secondary-dt">@(string.IsNullOrEmpty(appt.VehicleModel) ? "—" : appt.VehicleModel)</small>
                            </td>
                            <td>
                                <span class="fw-semibold text-white">@appt.ServiceType</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(appt.Notes))
                                {
                                    <span class="text-secondary-dt small text-truncate d-inline-block" style="max-width: 180px;" title="@appt.Notes">
                                        @appt.Notes
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary small">—</span>
                                }
                            </td>
                            <td>
                                @if (appt.Status == "Confirmed")
                                {
                                    <span class="badge bg-success text-dark"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                                }
                                else if (appt.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Cancelled</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <!-- 1. Confirm Button -->
                                    @if (appt.Status == "Pending")
                                    {
                                        <form asp-action="Confirm" asp-route-id="@appt.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success text-dark fw-bold" title="Confirm this appointment">
                                                <i class="bi bi-check2"></i> Confirm
                                            </button>
                                        </form>
                                    }

                                    <!-- 2. Reschedule Button -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-dt btn-reschedule"
                                            data-id="@appt.Id"
                                            data-no="@appt.AppointmentNo"
                                            data-date="@appt.AppointmentDate.ToString("yyyy-MM-dd")"
                                            data-slot="@appt.TimeSlot"
                                            data-customer="@appt.CustomerName"
                                            data-vehicle="@appt.VehicleNo"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rescheduleModal"
                                            title="Reschedule appointment">
                                        <i class="bi bi-calendar-event"></i> Reschedule
                                    </button>

                                    <!-- 3. Cancel Button -->
                                    @if (appt.Status != "Cancelled")
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-cancel"
                                                data-id="@appt.Id"
                                                data-no="@appt.AppointmentNo"
                                                data-customer="@appt.CustomerName"
                                                data-vehicle="@appt.VehicleNo"
                                                data-bs-toggle="modal"
                                                data-bs-target="#cancelModal"
                                                title="Cancel appointment">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Modal: Reschedule Appointment -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="rescheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary text-white">
            <form asp-action="Reschedule" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rescheduleId" />

                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="rescheduleModalLabel">
                        <i class="bi bi-calendar-event text-red me-2"></i>Reschedule Appointment
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="p-3 rounded-3 bg-black border border-secondary mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">Reference:</span>
                            <strong class="text-red" id="rescheduleRef"></strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">Customer:</span>
                            <span class="text-white" id="rescheduleCustomer"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary">Vehicle:</span>
                            <span class="badge bg-danger" id="rescheduleVehicle"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Appointment Date <span class="text-red">*</span></label>
                        <input type="date" name="newDate" id="rescheduleDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Time Slot <span class="text-red">*</span></label>
                        <select name="newSlot" id="rescheduleSlot" class="form-select" required>
                            @foreach (var s in allTimeSlots)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                        <small class="text-secondary-dt mt-1 d-block" id="slotAvailabilityStatus"></small>
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Reschedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Cancel Appointment -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary text-white">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="cancelId" />

                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger" id="cancelModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Appointment
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="text-white mb-2">
                        Are you sure you want to cancel appointment <strong class="text-red" id="cancelRef"></strong> for
                        <span id="cancelCustomer" class="fw-semibold"></span> (<span id="cancelVehicle" class="badge bg-danger"></span>)?
                    </p>

                    <div class="mb-3">
                        <label class="form-label">Cancellation Reason</label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Customer requested postponement, Parts not in stock" />
                    </div>
                </div>

                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Keep Appointment</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Populate Reschedule modal
            $('.btn-reschedule').on('click', function () {
                var btn = $(this);
                $('#rescheduleId').val(btn.data('id'));
                $('#rescheduleRef').text(btn.data('no'));
                $('#rescheduleCustomer').text(btn.data('customer'));
                $('#rescheduleVehicle').text(btn.data('vehicle'));
                $('#rescheduleDate').val(btn.data('date'));
                $('#rescheduleSlot').val(btn.data('slot'));
                checkRescheduleSlot();
            });

            // Populate Cancel modal
            $('.btn-cancel').on('click', function () {
                var btn = $(this);
                $('#cancelId').val(btn.data('id'));
                $('#cancelRef').text(btn.data('no'));
                $('#cancelCustomer').text(btn.data('customer'));
                $('#cancelVehicle').text(btn.data('vehicle'));
            });

            // Dynamic slot availability check in reschedule modal
            $('#rescheduleDate').on('change', checkRescheduleSlot);

            function checkRescheduleSlot() {
                var selectedDate = $('#rescheduleDate').val();
                var currentApptId = $('#rescheduleId').val();
                if (!selectedDate) return;

                $.ajax({
                    url: '@Url.Action("GetBookedSlots", "Appointments", new { area = "" })',
                    data: { date: selectedDate },
                    type: 'GET',
                    success: function (res) {
                        if (res && res.success) {
                            var booked = res.bookedSlots || [];
                            var options = $('#rescheduleSlot option');
                            options.each(function () {
                                var val = $(this).val();
                                if (booked.indexOf(val) !== -1) {
                                    $(this).text(val + ' (Booked)').prop('disabled', true);
                                } else {
                                    $(this).text(val).prop('disabled', false);
                                }
                            });
                        }
                    }
                });
            }
        });
    </script>
}

