@model InvoiceViewModel
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNo}";
}

@section Styles {
    <style>
        /* Invoice screen & print specific styling */
        .invoice-box {
            background-color: var(--dt-gray-900);
            border: 1px solid var(--dt-gray-700);
            border-radius: var(--dt-radius);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .invoice-header-title {
            letter-spacing: 2px;
            font-size: 1.8rem;
            font-weight: 800;
        }

        .invoice-table th {
            background-color: rgba(255, 255, 255, 0.05);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-row {
            font-size: 0.95rem;
        }

        .balance-highlight {
            font-size: 1.25rem;
            font-weight: 800;
        }

        /* PRINT MEDIA STYLING */
        @@media print {
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }

            body, .dt-body {
                background: #ffffff !important;
                color: #000000 !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .dt-nav-wrap,
            .dt-footer,
            .d-print-none,
            .modal,
            .btn {
                display: none !important;
            }

            .container-xxl, .dt-main {
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .invoice-box {
                background-color: #ffffff !important;
                color: #000000 !important;
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
            }

            .text-white {
                color: #000000 !important;
            }

            .text-secondary-dt, .text-secondary {
                color: #555555 !important;
            }

            .text-danger, .text-red {
                color: #b7000b !important;
            }

            .text-success {
                color: #198754 !important;
            }

            .table-dark {
                --bs-table-bg: transparent !important;
                --bs-table-color: #000000 !important;
                border-color: #dddddd !important;
            }

            .table-dark th {
                background-color: #f1f1f1 !important;
                color: #000000 !important;
                border-bottom: 2px solid #333333 !important;
            }

            .table-dark td {
                border-bottom: 1px solid #e5e5e5 !important;
                color: #000000 !important;
            }

            .border-secondary {
                border-color: #dddddd !important;
            }

            .bg-dark {
                background-color: #f8f9fa !important;
            }

            .badge {
                border: 1px solid #333 !important;
                color: #000 !important;
            }

            .invoice-signature-block {
                display: block !important;
                margin-top: 40px !important;
                page-break-inside: avoid;
            }
        }
    </style>
}

<!-- Top Action Toolbar (Hidden during print) -->
<div class="d-flex justify-content-between align-items-center mb-4 d-print-none flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="btn btn-link text-secondary p-0 mb-1 d-inline-block text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Back to Invoices
        </a>
        <h1 class="dt-h1 mb-0"><i class="bi bi-receipt text-red me-2"></i>Invoice @Model.InvoiceNo</h1>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <!-- Print Button -->
        <button type="button" class="btn btn-outline-dt" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print Invoice
        </button>

        @if (Model.BalanceDue > 0)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal">
                <i class="bi bi-cash-stack me-1"></i>Record Payment
            </button>
            <a asp-action="Payment" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-credit-card me-1"></i>Full Payment Form
            </a>
        }
        else
        {
            <span class="badge bg-success text-dark px-3 py-2 fs-6">
                <i class="bi bi-check-circle-fill me-1"></i>Fully Paid
            </span>
        }
    </div>
</div>

<!-- Status Banner (Hidden during print) -->
@if (Model.BalanceDue > 0)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Payment Pending:</strong> Outstanding balance of <strong>LKR @Model.BalanceDue.ToString("N2")</strong> is due by @Model.DueDate.ToString("yyyy-MM-dd").
        </div>
        <button class="btn btn-sm btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#paymentModal">
            Pay Now
        </button>
    </div>
}

<!-- Printable Invoice Card Sheet -->
<div class="invoice-box p-4 p-md-5 mb-5">
    <!-- Garage Header -->
    <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-4 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-gear-wide-connected text-red fs-2"></i>
                <h2 class="text-white fw-bold mb-0">D TECH <span class="text-red">MOTORS</span></h2>
            </div>
            <p class="text-secondary small mb-1 fw-semibold">D Tech Motors & Modification (Pvt) Ltd</p>
            <p class="text-secondary small mb-1">123 Highlevel Road, Battaramulla, Sri Lanka</p>
            <div class="text-secondary small">
                <span><i class="bi bi-telephone me-1"></i>+94 11 234 5678 / +94 77 123 4567</span> &middot;
                <span><i class="bi bi-envelope me-1"></i>billing@dtechmotors.lk</span>
            </div>
            <small class="text-secondary">Business Reg: PV 109823 &middot; VAT No: 2026-88</small>
        </div>
        <div class="text-end">
            <h2 class="invoice-header-title text-white mb-1">INVOICE</h2>
            <div class="fs-4 text-red fw-bold mb-1">@Model.InvoiceNo</div>
            <div class="text-secondary small"><strong>Invoice Date:</strong> @Model.IssueDate.ToString("yyyy-MM-dd")</div>
            <div class="text-secondary small"><strong>Due Date:</strong> @Model.DueDate.ToString("yyyy-MM-dd")</div>
            @if (!string.IsNullOrEmpty(Model.JobCardNo))
            {
                <div class="text-secondary small mt-1">
                    <strong>Job Ref:</strong> <span class="badge bg-dark border border-secondary text-secondary">@Model.JobCardNo</span>
                </div>
            }
            <div class="mt-2">
                @if (Model.Status == "Paid")
                {
                    <span class="badge bg-success text-dark px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>PAID IN FULL</span>
                }
                else if (Model.Status == "Partially Paid")
                {
                    <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-clock-history me-1"></i>PARTIALLY PAID</span>
                }
                else
                {
                    <span class="badge bg-danger text-white px-2 py-1"><i class="bi bi-exclamation-circle me-1"></i>PAYMENT DUE</span>
                }
            </div>
        </div>
    </div>

    <!-- Customer & Vehicle Info -->
    <div class="row g-4 mb-4 pb-2">
        <div class="col-6">
            <div class="p-3 bg-dark rounded border border-secondary">
                <h6 class="text-red text-uppercase fw-bold mb-2 small"><i class="bi bi-person me-1"></i>Customer Details (Billed To)</h6>
                <div class="text-white fw-bold fs-6">@Model.CustomerName</div>
                <div class="text-secondary small mt-1"><i class="bi bi-telephone me-1"></i>@Model.CustomerPhone</div>
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <div class="text-secondary small"><i class="bi bi-envelope me-1"></i>@Model.CustomerEmail</div>
                }
                @if (!string.IsNullOrEmpty(Model.CustomerAddress))
                {
                    <div class="text-secondary small"><i class="bi bi-geo-alt me-1"></i>@Model.CustomerAddress</div>
                }
            </div>
        </div>

        <div class="col-6">
            <div class="p-3 bg-dark rounded border border-secondary">
                <h6 class="text-red text-uppercase fw-bold mb-2 small"><i class="bi bi-car-front me-1"></i>Vehicle Details</h6>
                <div class="text-white fw-bold fs-6">@Model.VehicleNo</div>
                @if (!string.IsNullOrEmpty(Model.VehicleModel))
                {
                    <div class="text-secondary small mt-1"><strong>Model:</strong> @Model.VehicleModel</div>
                }
                @if (Model.Mileage.HasValue)
                {
                    <div class="text-secondary small"><strong>Mileage:</strong> @Model.Mileage.Value.ToString("N0") km</div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="text-secondary small mt-1"><em>@Model.Notes</em></div>
                }
            </div>
        </div>
    </div>

    <!-- 1. Parts Section -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="text-white fw-bold mb-0"><i class="bi bi-box-seam me-2 text-red"></i>Replacement Parts & Materials</h5>
            <span class="text-secondary small">Subtotal: LKR @Model.PartsTotal.ToString("N2")</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-bordered align-middle invoice-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th>Part Description</th>
                        <th class="text-center" style="width: 15%;">Quantity</th>
                        <th class="text-end" style="width: 20%;">Unit Price (LKR)</th>
                        <th class="text-end" style="width: 20%;">Total (LKR)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Parts.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-secondary text-center py-2 fst-italic">No parts billed for this job.</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Parts.Count; i++)
                        {
                            var part = Model.Parts[i];
                            <tr>
                                <td class="text-secondary text-center">@(i + 1)</td>
                                <td class="text-white fw-medium">@part.PartName</td>
                                <td class="text-center text-white">@part.Quantity</td>
                                <td class="text-end text-white">@part.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold text-white">@part.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. Labour Section -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="text-white fw-bold mb-0"><i class="bi bi-tools me-2 text-red"></i>Labour & Service Operations</h5>
            <span class="text-secondary small">Subtotal: LKR @Model.LabourTotal.ToString("N2")</span>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-bordered align-middle invoice-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th>Service / Labour Description</th>
                        <th class="text-center" style="width: 15%;">Hours</th>
                        <th class="text-end" style="width: 20%;">Hourly Rate (LKR)</th>
                        <th class="text-end" style="width: 20%;">Total (LKR)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Labour.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-secondary text-center py-2 fst-italic">No labour charges billed.</td>
                        </tr>
                    }
                    else
                    {
                        for (int i = 0; i < Model.Labour.Count; i++)
                        {
                            var l = Model.Labour[i];
                            <tr>
                                <td class="text-secondary text-center">@(i + 1)</td>
                                <td class="text-white fw-medium">@l.Description</td>
                                <td class="text-center text-white">@l.Hours.ToString("0.##")</td>
                                <td class="text-end text-white">@l.HourlyRate.ToString("N2")</td>
                                <td class="text-end fw-semibold text-white">@l.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Financial Totals & Balance Summary -->
    <div class="row justify-content-end mb-4">
        <div class="col-md-6 col-lg-5">
            <div class="p-3 bg-dark rounded border border-secondary">
                <div class="d-flex justify-content-between summary-row py-1 text-secondary">
                    <span>Parts Subtotal:</span>
                    <span class="text-white">LKR @Model.PartsTotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between summary-row py-1 text-secondary">
                    <span>Labour Subtotal:</span>
                    <span class="text-white">LKR @Model.LabourTotal.ToString("N2")</span>
                </div>
                <hr class="border-secondary my-2" />
                <div class="d-flex justify-content-between summary-row py-1">
                    <span class="fw-bold text-white fs-6">Grand Total:</span>
                    <span class="fw-bold text-white fs-6">LKR @Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between summary-row py-1">
                    <span class="fw-bold text-success">Paid Amount:</span>
                    <span class="fw-bold text-success">(-) LKR @Model.PaidAmount.ToString("N2")</span>
                </div>
                <hr class="border-secondary my-2" />
                <div class="d-flex justify-content-between align-items-center pt-1">
                    <span class="fw-bold fs-6 @(Model.BalanceDue > 0 ? "text-danger" : "text-white")">Balance Due:</span>
                    <span class="balance-highlight @(Model.BalanceDue > 0 ? "text-danger" : "text-success")">
                        LKR @Model.BalanceDue.ToString("N2")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment History / Ledger -->
    <div class="mb-4">
        <h6 class="text-white fw-bold mb-2"><i class="bi bi-clock-history me-2 text-red"></i>Payment History & Receipts</h6>
        <div class="table-responsive">
            <table class="table table-dark table-sm table-bordered align-middle mb-0">
                <thead class="text-secondary small">
                    <tr>
                        <th>Date</th>
                        <th>Payment Method</th>
                        <th>Reference / Slip No.</th>
                        <th>Recorded By</th>
                        <th>Notes</th>
                        <th class="text-end">Amount Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payments.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-secondary text-center py-2 fst-italic">No payments recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pm in Model.Payments)
                        {
                            <tr>
                                <td class="text-white small">@pm.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge bg-secondary text-light">@pm.PaymentMethod</span>
                                </td>
                                <td class="text-white small"><code>@pm.ReferenceNo</code></td>
                                <td class="text-secondary small">@(pm.RecordedBy ?? "Front Desk")</td>
                                <td class="text-secondary small">@(pm.Notes ?? "—")</td>
                                <td class="text-end fw-bold text-success">LKR @pm.Amount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bank Details & Payment Instructions -->
    <div class="row g-3 border-top border-secondary pt-3 mt-4 small text-secondary">
        <div class="col-md-7">
            <strong>Payment Instructions & Bank Transfer Info:</strong><br />
            Bank: <strong>Bank of Ceylon (BOC)</strong> &middot; Account: <strong>0012345678</strong><br />
            Account Name: <strong>D Tech Motors and Modification (Pvt) Ltd</strong> &middot; Branch: <strong>Battaramulla</strong><br />
            <em>Please forward electronic transfer receipts to billing@dtechmotors.lk quoting the Invoice No.</em>
        </div>
        <div class="col-md-5 text-md-end">
            <div>All services warranty covered for 30 days or 1,000 km.</div>
            <div>Thank you for choosing <strong>D Tech Motors</strong>!</div>
        </div>
    </div>

    <!-- Print Signatures Block -->
    <div class="invoice-signature-block mt-5 pt-4 border-top border-secondary d-none">
        <div class="row text-center">
            <div class="col-6">
                <div style="border-top: 1px dashed #666; width: 60%; margin: 40px auto 5px auto;"></div>
                <small class="text-secondary">Customer Signature & Date</small>
            </div>
            <div class="col-6">
                <div style="border-top: 1px dashed #666; width: 60%; margin: 40px auto 5px auto;"></div>
                <small class="text-secondary">Authorized Garage Officer</small>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Quick Payment Entry Form -->
@if (Model.BalanceDue > 0)
{
    <div class="modal fade d-print-none" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark border-secondary text-white">
                <form asp-action="Payment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="InvoiceId" value="@Model.Id" />
                    <input type="hidden" name="InvoiceNo" value="@Model.InvoiceNo" />
                    <input type="hidden" name="CustomerName" value="@Model.CustomerName" />
                    <input type="hidden" name="VehicleNo" value="@Model.VehicleNo" />
                    <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />
                    <input type="hidden" name="CurrentPaid" value="@Model.PaidAmount" />
                    <input type="hidden" name="BalanceDue" value="@Model.BalanceDue" />

                    <div class="modal-header border-secondary">
                        <h5 class="modal-title" id="paymentModalLabel">
                            <i class="bi bi-cash-coin text-success me-2"></i>Record Payment for @Model.InvoiceNo
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="p-3 bg-black rounded border border-secondary mb-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Customer:</span>
                                <span class="text-white fw-bold">@Model.CustomerName (@Model.VehicleNo)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Total Invoiced:</span>
                                <span class="text-white">LKR @Model.TotalAmount.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-secondary">Already Paid:</span>
                                <span class="text-success">LKR @Model.PaidAmount.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold pt-1 border-top border-secondary">
                                <span class="text-danger">Current Balance Due:</span>
                                <span class="text-danger">LKR @Model.BalanceDue.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white">Payment Amount (LKR) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">LKR</span>
                                <input type="number" step="0.01" min="0.01" max="@Model.BalanceDue" name="Amount" class="form-control text-white" value="@Model.BalanceDue" required />
                            </div>
                            <small class="text-secondary-dt">Maximum allowable payment is remaining balance (LKR @Model.BalanceDue.ToString("N2")).</small>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-white">Payment Method <span class="text-danger">*</span></label>
                                <select name="PaymentMethod" class="form-select bg-dark border-secondary text-white" required>
                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-white">Payment Date <span class="text-danger">*</span></label>
                                <input type="date" name="PaymentDate" class="form-control bg-dark border-secondary text-white" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white">Reference No. / Receipt No. <span class="text-danger">*</span></label>
                            <input type="text" name="ReferenceNo" class="form-control bg-dark border-secondary text-white" placeholder="e.g. REC-10492 or POS-AUTH-991" value="REC-@DateTime.Now.ToString("yyyyMMdd-HHmm")" required />
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-white">Notes / Remarks</label>
                            <textarea name="Notes" class="form-control bg-dark border-secondary text-white" rows="2" placeholder="Optional cashier note or terminal ref"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Confirm & Save Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
