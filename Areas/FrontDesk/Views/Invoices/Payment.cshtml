@model PaymentEntryViewModel
@{
    ViewData["Title"] = $"Record Payment - {Model.InvoiceNo}";
}

<div class="dt-page-head mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="dt-back text-secondary-dt text-decoration-none mb-2 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i>Back to Invoice @Model.InvoiceNo
        </a>
        <h1 class="dt-h1 mb-1"><i class="bi bi-cash-coin me-2 text-red"></i>Record Payment</h1>
        <p class="text-secondary-dt mb-0">Record a customer settlement for Invoice <strong>@Model.InvoiceNo</strong></p>
    </div>
</div>

<form method="post" asp-action="Payment" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="InvoiceId" />
    <input type="hidden" asp-for="InvoiceNo" />
    <input type="hidden" asp-for="CustomerName" />
    <input type="hidden" asp-for="VehicleNo" />
    <input type="hidden" asp-for="TotalAmount" />
    <input type="hidden" asp-for="CurrentPaid" />
    <input type="hidden" asp-for="BalanceDue" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger dt-alert mb-4"></div>

    <div class="row g-4">
        <!-- Payment Entry Fields -->
        <div class="col-lg-7">
            <section class="dt-card p-4 mb-4">
                <h2 class="dt-h2"><i class="bi bi-credit-card me-2 text-red"></i>Payment Information</h2>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Amount" class="form-label">Payment Amount (LKR) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">LKR</span>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" max="@Model.BalanceDue" class="form-control fs-5 fw-bold" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="form-text text-secondary-dt">Outstanding balance: LKR @Model.BalanceDue.ToString("N2")</div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentMethod" class="form-label">Payment Method <span class="text-danger">*</span></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentDate" class="form-label">Payment Date <span class="text-danger">*</span></label>
                        <input asp-for="PaymentDate" type="date" class="form-control" />
                        <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ReferenceNo" class="form-label">Receipt No. / Transaction Ref <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-hash"></i></span>
                            <input asp-for="ReferenceNo" class="form-control" placeholder="e.g. REC-2026-0042 or POS-AUTH-882" />
                        </div>
                        <span asp-validation-for="ReferenceNo" class="text-danger small"></span>
                        <div class="form-text text-secondary-dt">Reference printed on cash receipt, credit card slip, or bank transfer reference.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Notes / Remarks</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Optional notes regarding this transaction (e.g. Paid in full at front counter)"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>
            </section>
        </div>

        <!-- Invoice Context Card -->
        <div class="col-lg-5">
            <section class="dt-card p-4 mb-4">
                <h2 class="dt-h2"><i class="bi bi-file-earmark-text me-2 text-red"></i>Invoice Overview</h2>

                <div class="p-3 bg-dark rounded border border-secondary mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Invoice Number:</span>
                        <span class="text-white fw-bold">@Model.InvoiceNo</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Customer:</span>
                        <span class="text-white">@Model.CustomerName</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary small">Vehicle Reg No:</span>
                        <span class="text-danger fw-bold">@Model.VehicleNo</span>
                    </div>
                </div>

                <div class="p-3 bg-dark rounded border border-secondary mb-4">
                    <div class="d-flex justify-content-between mb-2 text-secondary small">
                        <span>Total Invoiced:</span>
                        <span class="text-white">LKR @Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-secondary small">
                        <span>Already Settled:</span>
                        <span class="text-success">LKR @Model.CurrentPaid.ToString("N2")</span>
                    </div>
                    <hr class="border-secondary my-2" />
                    <div class="d-flex justify-content-between fw-bold">
                        <span class="text-danger">Current Balance:</span>
                        <span class="text-danger fs-5">LKR @Model.BalanceDue.ToString("N2")</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-2">
                    <i class="bi bi-check-lg me-1"></i>Confirm & Record Payment
                </button>
                <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-dt w-100">
                    Cancel
                </a>
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
