@model List<InvoiceViewModel>
@{
    ViewData["Title"] = "Invoices & Payments";
    var search = (string)ViewBag.Search;
    var status = (string)ViewBag.Status;
    decimal totalBilled = ViewBag.TotalBilled ?? 0m;
    decimal totalPaid = ViewBag.TotalPaid ?? 0m;
    decimal totalBalance = ViewBag.TotalBalance ?? 0m;
}

<div class="dt-page-head d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="dt-h1 mb-1"><i class="bi bi-receipt me-2 text-red"></i>Invoices & Billing</h1>
        <p class="text-secondary-dt mb-0">Customer invoices, payment tracking and balance settlement</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="FrontDesk" asp-controller="JobCards" asp-action="Board" class="btn btn-outline-dt">
            <i class="bi bi-clipboard-check me-1"></i>From Job Board
        </a>
    </div>
</div>

<!-- Financial Summary KPIs -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-info fs-3">
                <i class="bi bi-wallet2"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Total Invoiced</small>
                <div class="fs-4 fw-bold text-white">LKR @totalBilled.ToString("N2")</div>
                <small class="text-secondary-dt">Across all issued invoices</small>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-success fs-3">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Total Collected</small>
                <div class="fs-4 fw-bold text-success">LKR @totalPaid.ToString("N2")</div>
                <small class="text-secondary-dt">@ViewBag.PaidCount fully settled &middot; @ViewBag.PartialCount partial</small>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-xl-4">
        <div class="dt-card p-3 d-flex align-items-center gap-3">
            <div class="p-3 rounded-circle bg-dark border border-secondary text-danger fs-3">
                <i class="bi bi-exclamation-circle"></i>
            </div>
            <div>
                <small class="text-secondary-dt text-uppercase fw-semibold">Outstanding Balance</small>
                <div class="fs-4 fw-bold text-danger">LKR @totalBalance.ToString("N2")</div>
                <small class="text-secondary-dt">@ViewBag.UnpaidCount unpaid invoices</small>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="dt-card dt-toolbar mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input name="search" type="search" value="@search" class="form-control" placeholder="Search invoice no, job no, customer or vehicle reg..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All payment statuses</option>
                <option value="Unpaid" selected="@(status == "Unpaid")">Unpaid only</option>
                <option value="Partially Paid" selected="@(status == "Partially Paid")">Partially Paid only</option>
                <option value="Paid" selected="@(status == "Paid")">Fully Paid only</option>
            </select>
        </div>
        <div class="col-md-2 text-md-end">
            <a asp-action="Index" class="btn btn-outline-dt w-100"><i class="bi bi-x-circle me-1"></i>Reset</a>
        </div>
    </form>
</div>

<!-- Invoices Table -->
@if (Model.Count == 0)
{
    <div class="dt-card p-5 text-center">
        <i class="bi bi-receipt fs-1 text-secondary mb-3 d-block"></i>
        <h4 class="text-white">No invoices found</h4>
        <p class="text-secondary-dt mb-3">There are no invoices matching your criteria. Invoices can be generated directly from completed job cards.</p>
        <a asp-area="FrontDesk" asp-controller="JobCards" asp-action="Board" class="btn btn-primary btn-sm">
            <i class="bi bi-clipboard-check me-1"></i>Go to Job Card Board
        </a>
    </div>
}
else
{
    <div class="dt-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Invoice #</th>
                        <th>Date</th>
                        <th>Customer & Vehicle</th>
                        <th>Job Ref</th>
                        <th class="text-end">Total Amount</th>
                        <th class="text-end">Paid Amount</th>
                        <th class="text-end">Balance</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@inv.Id" class="fw-bold text-white text-decoration-none">
                                    @inv.InvoiceNo
                                </a>
                            </td>
                            <td>
                                <span class="text-secondary small">@inv.IssueDate.ToString("yyyy-MM-dd")</span>
                            </td>
                            <td>
                                <div class="fw-bold text-white">@inv.CustomerName</div>
                                <div class="small text-danger fw-semibold">@inv.VehicleNo</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(inv.JobCardNo))
                                {
                                    <span class="badge bg-dark border border-secondary text-secondary">@inv.JobCardNo</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-end fw-semibold text-white">
                                LKR @inv.TotalAmount.ToString("N2")
                            </td>
                            <td class="text-end text-success fw-semibold">
                                LKR @inv.PaidAmount.ToString("N2")
                            </td>
                            <td class="text-end fw-bold @(inv.BalanceDue > 0 ? "text-danger" : "text-secondary")">
                                LKR @inv.BalanceDue.ToString("N2")
                            </td>
                            <td>
                                @if (inv.Status == "Paid")
                                {
                                    <span class="badge bg-success text-dark"><i class="bi bi-check-circle-fill me-1"></i>Paid</span>
                                }
                                else if (inv.Status == "Partially Paid")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger text-white"><i class="bi bi-exclamation-circle me-1"></i>Unpaid</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@inv.Id" class="btn btn-outline-dt" title="View & Print Invoice">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                    @if (inv.BalanceDue > 0)
                                    {
                                        <a asp-action="Payment" asp-route-id="@inv.Id" class="btn btn-primary" title="Record Payment">
                                            <i class="bi bi-cash me-1"></i>Pay
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
