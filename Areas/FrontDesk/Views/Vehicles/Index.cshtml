@model List<VehicleRecord>
@{
    ViewData["Title"] = "All Vehicles";
    var customers = (Dictionary<int, string>)ViewBag.Customers;
    var search = (string)ViewBag.Search;
}

<div class="dt-page-head d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="dt-h1 mb-1"><i class="bi bi-car-front me-2 text-red"></i>All Vehicles</h1>
        <p class="text-secondary-dt mb-0">@ViewBag.TotalCount vehicle@(ViewBag.TotalCount == 1 ? "" : "s") in the registry</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add vehicle</a>
</div>

<!-- Search Toolbar -->
<div class="dt-card dt-toolbar mb-4 p-3">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
                <input name="search" type="search" value="@search"
                       class="form-control"
                       placeholder="Search by registration, make, model or colour..." />
                <button class="btn btn-primary" type="submit">Search</button>
            </div>
        </div>
        <div class="col-md-3 text-md-end">
            <a asp-action="Index" class="btn btn-outline-dt w-100">
                <i class="bi bi-x-circle me-1"></i>Reset
            </a>
        </div>
    </form>
</div>

<!-- Vehicle Table -->
@if (Model.Count == 0)
{
    <div class="dt-card p-5 text-center">
        <i class="bi bi-car-front fs-1 text-secondary mb-3 d-block"></i>
        <h4 class="text-white">No vehicles found</h4>
        <p class="text-secondary-dt mb-3">
            @(string.IsNullOrWhiteSpace(search)
                ? "No vehicles registered yet."
                : $"No vehicles matching \"{search}\".")
        </p>
        @if (string.IsNullOrWhiteSpace(search))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add vehicle</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-dt btn-sm">Clear search</a>
        }
    </div>
}
else
{
    <div class="dt-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Registration No.</th>
                        <th>Make &amp; Model</th>
                        <th>Year</th>
                        <th>Colour</th>
                        <th>Mileage</th>
                        <th>Owner</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        var ownerName = customers.TryGetValue(v.OwnerId, out var n) ? n : "Unknown";
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-white font-monospace">@v.RegistrationNo</span>
                            </td>
                            <td><div class="text-white">@v.Make @v.Model</div></td>
                            <td><span class="text-secondary">@v.Year</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(v.Colour))
                                {
                                    <span class="badge bg-secondary text-light fw-normal py-1 px-2">@v.Colour</span>
                                }
                                else { <span class="text-secondary">—</span> }
                            </td>
                            <td>
                                @if (v.Mileage.HasValue)
                                { <span class="text-secondary">@v.Mileage.Value.ToString("N0") km</span> }
                                else { <span class="text-secondary">—</span> }
                            </td>
                            <td>
                                <a asp-controller="Customers" asp-action="Vehicles" asp-route-id="@v.OwnerId"
                                   class="text-white text-decoration-none">
                                    <i class="bi bi-person me-1 text-red"></i>@ownerName
                                </a>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@v.Id"
                                       class="btn btn-outline-dt" title="Edit vehicle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#delVeh-@v.Id"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="delVeh-@v.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark border-secondary text-white">
                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title">
                                                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Vehicle
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Remove <strong>@v.RegistrationNo</strong> (@v.Year @v.Make @v.Model)?
                                                This action cannot be undone.
                                            </div>
                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
