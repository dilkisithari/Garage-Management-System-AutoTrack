@model List<VehicleRecord>
@{
    var customer = (AutoTrack.Models.CustomerRecord)ViewBag.Customer;
    ViewData["Title"] = $"Vehicles – {customer.FullName}";
}

<div class="dt-page-head d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="dt-back text-secondary-dt text-decoration-none mb-2 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i>Back to customers
        </a>
        <h1 class="dt-h1 mb-1">
            <i class="bi bi-car-front me-2 text-red"></i>@customer.FullName's Vehicles
        </h1>
        <p class="text-secondary-dt mb-0">
            <i class="bi bi-telephone me-1"></i>@customer.Phone
            @if (!string.IsNullOrEmpty(customer.Email))
            {
                <span class="ms-2"><i class="bi bi-envelope me-1"></i>@customer.Email</span>
            }
        </p>
    </div>
    <a asp-controller="Vehicles" asp-action="Create" asp-route-ownerId="@customer.Id"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add vehicle
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="dt-card p-5 text-center">
        <i class="bi bi-car-front fs-1 text-secondary mb-3 d-block"></i>
        <h4 class="text-white">No vehicles registered</h4>
        <p class="text-secondary-dt mb-3">@customer.FullName has no vehicles on file yet.</p>
        <a asp-controller="Vehicles" asp-action="Create" asp-route-ownerId="@customer.Id"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add vehicle
        </a>
    </div>
}
else
{
    <div class="dt-card p-0 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Registration No.</th>
                        <th>Make &amp; Model</th>
                        <th>Year</th>
                        <th>Colour</th>
                        <th>Mileage</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-white font-monospace fs-6">@v.RegistrationNo</span>
                            </td>
                            <td>
                                <div class="text-white">@v.Make @v.Model</div>
                            </td>
                            <td><span class="text-secondary">@v.Year</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(v.Colour))
                                {
                                    <span class="badge bg-secondary text-light fw-normal py-1 px-2">@v.Colour</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td>
                                @if (v.Mileage.HasValue)
                                {
                                    <span class="text-secondary">@v.Mileage.Value.ToString("N0") km</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="Vehicles" asp-action="Edit" asp-route-id="@v.Id"
                                       class="btn btn-outline-dt" title="Edit vehicle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteVehicleModal-@v.Id"
                                            title="Delete vehicle">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Delete Vehicle Modal -->
                                <div class="modal fade text-start" id="deleteVehicleModal-@v.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content bg-dark border-secondary text-white">
                                            <div class="modal-header border-secondary">
                                                <h5 class="modal-title">
                                                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete Vehicle
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to remove
                                                <strong>@v.RegistrationNo</strong> (@v.Year @v.Make @v.Model)?
                                                This action cannot be undone.
                                            </div>
                                            <div class="modal-footer border-secondary">
                                                <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-controller="Vehicles" asp-action="Delete" asp-route-id="@v.Id"
                                                      asp-route-returnOwnerId="@customer.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
