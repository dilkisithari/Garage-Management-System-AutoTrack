@model JobLabourItem
@{
    var i = ViewData["i"]?.ToString() ?? "0";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<tr class="jc-row">
    <td>
        <input type="text" class="form-control form-control-sm" name="Labour[@(i)].Description" value="@Model.Description" maxlength="150" placeholder="e.g. Brake service" />
    </td>
    <td style="width:6rem">
        <input type="number" class="form-control form-control-sm text-end js-qty" name="Labour[@(i)].Hours" value="@Model.Hours.ToString("0.##", inv)" min="0" step="0.25" />
    </td>
    <td style="width:9rem">
        <input type="number" class="form-control form-control-sm text-end js-price" name="Labour[@(i)].Rate" value="@Model.Rate.ToString("0.00", inv)" min="0" step="0.01" />
    </td>
    <td class="text-end fw-semibold js-line-total" style="width:9rem">0.00</td>
    <td class="text-end" style="width:3rem">
        <button type="button" class="btn btn-sm btn-icon-danger btn-remove-row" aria-label="Remove labour line"><i class="bi bi-trash3"></i></button>
    </td>
</tr>
