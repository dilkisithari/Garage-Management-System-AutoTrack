@model QuotationViewModel
@{
    ViewData["Title"] = $"Quotation {Model.QuoteNo}";
    var isOwner = User.IsInRole("Owner");
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <a asp-action="Index" class="btn btn-link text-secondary p-0 mb-1"><i class="bi bi-arrow-left"></i> Back to Quotations</a>
        <h1 class="dt-h1 mb-0">Quotation @Model.QuoteNo</h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-outline-dt" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print / Save PDF</button>

        @if (Model.Status != "Converted")
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
        }

        <!-- Workflow Action Buttons -->
        @if (Model.Status == "Draft" || Model.Status == "Revision Requested")
        {
            <form asp-action="SubmitForApproval" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning"><i class="bi bi-send me-1"></i>Submit to Owner</button>
            </form>
        }

        @if (isOwner && Model.Status == "Pending Owner Approval")
        {
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalApprove"><i class="bi bi-check-circle me-1"></i>Owner Approve</button>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modalReject"><i class="bi bi-x-circle me-1"></i>Request Revision</button>
        }

        @if (Model.Status == "Approved by Owner")
        {
            <form asp-action="SendToCustomer" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-info text-dark"><i class="bi bi-envelope me-1"></i>Mark as Sent to Customer</button>
            </form>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalConvert"><i class="bi bi-arrow-repeat me-1"></i>Convert to Job Card</button>
        }
        else if (Model.Status == "Sent to Customer")
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalConvert"><i class="bi bi-arrow-repeat me-1"></i>Convert to Job Card</button>
        }
    </div>
</div>

<!-- Status Alerts -->
@if (Model.Status == "Pending Owner Approval")
{
    <div class="alert alert-warning mb-4 d-print-none">
        <i class="bi bi-clock-history me-2"></i><strong>Under Review:</strong> This quotation is waiting for Owner review and approval.
    </div>
}
else if (Model.Status == "Approved by Owner" && !string.IsNullOrEmpty(Model.OwnerRemarks))
{
    <div class="alert alert-info mb-4 d-print-none">
        <i class="bi bi-info-circle me-2"></i><strong>Owner Notes:</strong> @Model.OwnerRemarks
    </div>
}
else if (Model.Status == "Converted")
{
    <div class="alert alert-success mb-4 d-print-none">
        <i class="bi bi-check-circle-fill me-2"></i><strong>Converted:</strong> This quotation was converted to <strong>Job Card @Model.ConvertedJobCardNo</strong>.
    </div>
}

<!-- Printable Sheet -->
<div class="dt-card p-5 mb-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-4 mb-4">
        <div>
            <h2 class="text-white fw-bold mb-1">D TECH <span class="text-danger">MOTORS</span></h2>
            <p class="text-secondary mb-0">Vehicle Service • Modification • Performance Tuning</p>
            <small class="text-secondary">123 Highlevel Road, Colombo • Tel: +94 11 234 5678 • info@dtechmotors.lk</small>
        </div>
        <div class="text-end">
            <h3 class="text-white mb-1">QUOTATION</h3>
            <div class="fs-5 text-danger fw-bold">@Model.QuoteNo</div>
            <div class="text-secondary small">Date: @Model.DateCreated.ToString("yyyy-MM-dd")</div>
            <div class="text-secondary small">Valid Until: @Model.ExpiryDate.ToString("yyyy-MM-dd")</div>
        </div>
    </div>

    <!-- Client & Vehicle Details -->
    <div class="row g-4 mb-4">
        <div class="col-6">
            <h6 class="text-danger text-uppercase fw-bold mb-2">Customer Details</h6>
            <div class="text-white fw-bold">@Model.CustomerName</div>
            <div class="text-secondary">Phone: @Model.CustomerPhone</div>
            @if (!string.IsNullOrEmpty(Model.CustomerEmail)) { <div class="text-secondary">Email: @Model.CustomerEmail</div> }
        </div>
        <div class="col-6 text-end">
            <h6 class="text-danger text-uppercase fw-bold mb-2">Vehicle Details</h6>
            <div class="text-white fw-bold">@Model.VehicleNo (@Model.VehicleModel)</div>
            @if (Model.Mileage.HasValue) { <div class="text-secondary">Mileage: @Model.Mileage.Value.ToString("N0") km</div> }
            <div class="text-secondary mt-1"><em>Scope: @Model.CustomerRequest</em></div>
        </div>
    </div>

    <!-- Parts Table -->
    <h6 class="text-white fw-bold mb-2">Replacement Parts & Materials</h6>
    <table class="table table-bordered border-secondary text-white mb-4">
        <thead class="table-dark">
            <tr>
                <th>Item Description</th>
                <th class="text-center" style="width: 15%;">Qty</th>
                <th class="text-end" style="width: 20%;">Unit Price (LKR)</th>
                <th class="text-end" style="width: 25%;">Line Total (LKR)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Parts)
            {
                <tr>
                    <td>@p.PartName</td>
                    <td class="text-center">@p.Quantity</td>
                    <td class="text-end">@p.UnitPrice.ToString("N2")</td>
                    <td class="text-end">@p.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Labour Table -->
    <h6 class="text-white fw-bold mb-2">Labour & Services</h6>
    <table class="table table-bordered border-secondary text-white mb-4">
        <thead class="table-dark">
            <tr>
                <th>Service Description</th>
                <th class="text-center" style="width: 15%;">Hours</th>
                <th class="text-end" style="width: 20%;">Hourly Rate (LKR)</th>
                <th class="text-end" style="width: 25%;">Line Total (LKR)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Labour)
            {
                <tr>
                    <td>@l.Description</td>
                    <td class="text-center">@l.Hours.ToString("0.0")</td>
                    <td class="text-end">@l.Rate.ToString("N2")</td>
                    <td class="text-end">@l.LineTotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Totals -->
    <div class="row justify-content-end mb-4">
        <div class="col-md-5">
            <table class="table table-sm table-borderless text-white mb-0">
                <tr>
                    <td class="text-secondary">Parts Subtotal:</td>
                    <td class="text-end">LKR @Model.PartsSubtotal.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-secondary">Labour Subtotal:</td>
                    <td class="text-end">LKR @Model.LabourSubtotal.ToString("N2")</td>
                </tr>
                @if (Model.DiscountPercent > 0)
                {
                    <tr class="text-danger">
                        <td>Discount (@Model.DiscountPercent%):</td>
                        <td class="text-end">- LKR @Model.DiscountAmount.ToString("N2")</td>
                    </tr>
                }
                @if (Model.IncludeVat)
                {
                    <tr>
                        <td class="text-secondary">VAT (18%):</td>
                        <td class="text-end">LKR @Model.VatAmount.ToString("N2")</td>
                    </tr>
                }
                <tr class="border-top border-secondary fs-5 fw-bold text-danger">
                    <td>Grand Total:</td>
                    <td class="text-end">LKR @Model.GrandTotal.ToString("N2")</td>
                </tr>
            </table>
        </div>
    </div>

    <!-- Terms & Signature lines -->
    <div class="row mt-5 pt-4 border-top border-secondary text-secondary small">
        <div class="col-6">
            <strong>Notes / Warranty:</strong>
            <p>@(string.IsNullOrWhiteSpace(Model.Notes) ? "This estimate is valid for 14 days from date of issue. Genuine parts carry manufacturer warranty." : Model.Notes)</p>
        </div>
        <div class="col-3 text-center">
            <div style="border-bottom: 1px dashed #777; height: 50px;"></div>
            <span class="d-block mt-2">Workshop Manager / Owner</span>
        </div>
        <div class="col-3 text-center">
            <div style="border-bottom: 1px dashed #777; height: 50px;"></div>
            <span class="d-block mt-2">Customer Acceptance</span>
        </div>
    </div>
</div>

<!-- Audit Trail Tab (Demonstrates Trigger / Log Table functionality) -->
<div class="dt-card p-4 d-print-none">
    <h5 class="text-white mb-3"><i class="bi bi-clock-history me-2 text-danger"></i>Quotation Audit Trail (History)</h5>
    <div class="table-responsive">
        <table class="table dt-table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Action</th>
                    <th>User</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.AuditLogs.OrderByDescending(l => l.Timestamp))
                {
                    <tr>
                        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-secondary">@log.Action</span></td>
                        <td><strong>@log.ChangedBy</strong></td>
                        <td class="text-secondary">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Owner Approve -->
<div class="modal fade" id="modalApprove" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary text-white">
            <form asp-action="OwnerApprove" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Approve Quotation @Model.QuoteNo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to approve this quotation of <strong>LKR @Model.GrandTotal.ToString("N2")</strong>?</p>
                    <label class="form-label text-secondary">Owner Remarks (Optional)</label>
                    <textarea name="remarks" class="form-control" rows="2" placeholder="e.g. Approved with standard margin"></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Owner Request Revision -->
<div class="modal fade" id="modalReject" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary text-white">
            <form asp-action="OwnerReject" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Request Revision</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label text-secondary">Reason for Revision (Required)</label>
                    <textarea name="remarks" class="form-control" rows="3" required placeholder="Specify what needs to change in pricing or labor hours..."></textarea>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Send Back to Front Desk</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Convert to Job Card -->
<div class="modal fade" id="modalConvert" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark border-secondary text-white">
            <form asp-action="ConvertToJobCard" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Convert to Active Job Card</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>This will convert <strong>@Model.QuoteNo</strong> into a live job card and transfer all parts and labour items to the workshop floor.</p>
                    <label class="form-label text-secondary">Assign Lead Mechanic</label>
                    <select name="mechanic" class="form-select" asp-items="ViewBag.Mechanics" required>
                        <option value="">-- Select Mechanic --</option>
                    </select>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-dt" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Job Card</button>
                </div>
            </form>
        </div>
    </div>
</div>